diff --git a/src/glx/hardext.c b/src/glx/hardext.c
index c89a123..106f899 100644
--- a/src/glx/hardext.c
+++ b/src/glx/hardext.c
@@ -150,6 +150,16 @@ void GetHardwareExtensions(int notest)
     LOAD_EGL(eglCreateContext);
     LOAD_EGL(eglQueryString);
     LOAD_EGL(eglTerminate);
+    LOAD_EGL(eglGetCurrentContext);
+    LOAD_EGL(eglGetCurrentSurface);
+    LOAD_EGL(eglGetCurrentDisplay);
+
+    // The application may already have its own context current (e.g. Android GLSurfaceView):
+    // remember it, so it can be restored after probing with a temporary pbuffer context
+    EGLContext prevContext = egl_eglGetCurrentContext();
+    EGLDisplay prevDisplay = egl_eglGetCurrentDisplay();
+    EGLSurface prevDraw = egl_eglGetCurrentSurface(EGL_DRAW);
+    EGLSurface prevRead = egl_eglGetCurrentSurface(EGL_READ);
 
     EGLDisplay eglDisplay;
     EGLSurface eglSurface;
@@ -488,6 +498,10 @@ void GetHardwareExtensions(int notest)
     egl_eglDestroySurface(eglDisplay, eglSurface);
     egl_eglDestroyContext(eglDisplay, eglContext);
 
-    egl_eglTerminate(eglDisplay);
+    if (prevContext != EGL_NO_CONTEXT) {
+        // Display is shared with the application, don't terminate it
+        egl_eglMakeCurrent(prevDisplay, prevDraw, prevRead, prevContext);
+    } else
+        egl_eglTerminate(eglDisplay);
 #endif
 }

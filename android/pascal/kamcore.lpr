library kamcore;
{$I KaM_Remake.inc}
// Android native library with the KaM Remake engine.
// Units are listed in the same order as in KaM_Remake.dpr (so unit initialization order matches the desktop build),
// except for desktop-only units:
//   KM_FormMain - desktop form
//   KM_FormLogistics - desktop form
//   KM_FormLoading - desktop form
//   KM_VclMenuHint - desktop form
//   KM_VclHelpers - desktop form
//   iaWin.NameDelphiThreads - Windows-only thread naming
//   KM_DevPerfLogForm - dev perf-log form (VCL/LCL)
//   KM_VLC - libVLC video player (VIDEOS is not defined on Android)
//   KM_ResExporter - dev resource exporter
//   KM_SettingsDev - dev settings form
//   KromShellUtils - desktop dialogs/shell helpers (Android TKMMain doesn't use it)
//   KM_NetAuthSecure - not available in sources; KM_NetAuthUnsecure is used instead (DBG_SKIP_SECURE_AUTH)
uses
  cthreads, // Required for thread support
  cwstring, // UTF8 <-> UTF16 conversions with DefaultSystemCodePage = UTF8
